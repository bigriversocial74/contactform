# Runtime data must live outside the deploy tree
/storage/logs/
/storage/cache/
/storage/tmp/
/uploads/

# Logs, database exports, archives, and editor recovery files
*.log
*.sql.gz
*.zip
*.bak
*.orig

# Operating-system metadata
.DS_Store
Thumbs.db
