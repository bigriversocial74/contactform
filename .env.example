# Microgifter production environment example
# Never commit real credentials or copy production secrets into browser-visible code.

MG_APP_ENV=local
MG_DEBUG=true
MG_BASE_URL=http://localhost/microgifter
MG_TRUST_PROXY=false
MG_RUNTIME_PROFILE=hostgator

# Runtime feature flags
MG_ENABLE_POLLING_NOTIFICATIONS=true
MG_ENABLE_DB_OUTBOX=true
MG_ENABLE_QUEUE_WORKER=false
MG_ENABLE_REDIS=false
MG_ENABLE_WEBSOCKETS=false
MG_ENABLE_SSE=false
MG_ENABLE_PWA_PUSH=true
MG_POLL_INTERVAL_SECONDS=15
MG_POLL_FAST_INTERVAL_SECONDS=5
MG_TRACKING_EVENT_RETENTION_DAYS=365
MG_PWA_PUSH_BATCH_SIZE=25

# PWA push
MG_PWA_VAPID_PUBLIC_KEY=
MG_PWA_VAPID_PRIVATE_KEY=
MG_PWA_VAPID_SUBJECT=mailto:admin@microgifter.com

# Database
MG_DB_HOST=localhost
MG_DB_NAME=microgifter
MG_DB_USER=microgifter_user
MG_DB_PASS=change_me
MG_DB_CHARSET=utf8mb4

# Authentication email delivery. Production must use a real provider.
# HostGator/cPanel can use provider=mail when PHP mail delivery is configured.
MG_MAIL_ENABLED=false
MG_MAIL_PROVIDER=log
MG_MAIL_FROM_EMAIL=no-reply@microgifter.com
MG_MAIL_FROM_NAME=Microgifter

# Session policy
MG_SESSION_NAME=mg_session
MG_SESSION_DAYS=30
MG_SESSION_ABSOLUTE_MINUTES=43200
MG_SESSION_IDLE_MINUTES=720
MG_SESSION_ADMIN_ABSOLUTE_MINUTES=480
MG_SESSION_ADMIN_IDLE_MINUTES=30
MG_SESSION_ROTATION_MINUTES=15
MG_SESSION_COOKIE_SAMESITE=Lax
MG_STEP_UP_MAX_AGE_SECONDS=600

# Email ownership verification
MG_EMAIL_VERIFICATION_REQUIRED=true
MG_RESET_TOKEN_MINUTES=60
MG_VERIFY_TOKEN_MINUTES=1440

# MFA / TOTP
# Generate once with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Store this only in the host environment or api/config.local.php.
MG_MFA_ENCRYPTION_KEY=
MG_MFA_CHALLENGE_SECONDS=300
MG_MFA_ENFORCE_ENROLLED=true

# Rate limits use database-backed identifiers.
MG_RATE_LIMIT_LOGIN_MAX=8
MG_RATE_LIMIT_LOGIN_WINDOW=900
MG_RATE_LIMIT_REGISTER_MAX=10
MG_RATE_LIMIT_REGISTER_WINDOW=3600
MG_RATE_LIMIT_RECOVERY_MAX=5
MG_RATE_LIMIT_RECOVERY_WINDOW=3600
MG_RATE_LIMIT_PROFILE_MAX=20
MG_RATE_LIMIT_PROFILE_WINDOW=3600

# Production notes:
# MG_APP_ENV=production
# MG_DEBUG=false
# MG_BASE_URL=https://microgifter.com
# MG_MAIL_ENABLED=true
# MG_MAIL_PROVIDER=mail (or a production adapter)
# MG_TRUST_PROXY=true only when proxy headers are controlled by your infrastructure.
# Use HTTPS, a strong DB password, and a unique MG_MFA_ENCRYPTION_KEY.
