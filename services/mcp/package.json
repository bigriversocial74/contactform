{
  "name": "@microgifter/mcp-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microgifter MCP automation gateway and control-plane service.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run clean && npm run test",
    "validate:env": "npm run build && node dist/cli/validateEnvironment.js",
    "smoke": "node scripts/smoke-test.mjs",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  }
}
