server {
    listen 80;
    listen [::]:80;
    server_name __MCP_DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        add_header Content-Type text/plain;
        return 200 'Microgifter MCP TLS bootstrap\n';
    }
}
