# Microgifter MCP Node service environment.
# Copy to /etc/microgifter/mcp.env, replace every REPLACE_* value, then chmod 600.
NODE_ENV=production
MICROGIFTER_MCP_ENV=production
MICROGIFTER_MCP_RELEASE=mcp-production-vps-v1
MICROGIFTER_MCP_ENABLED=true
MICROGIFTER_MCP_INTERNAL_HTTP_ENABLED=true
MICROGIFTER_MCP_INTERNAL_HOST=127.0.0.1
MICROGIFTER_MCP_INTERNAL_PORT=8787
MICROGIFTER_MCP_PUBLIC_BASE_URL=https://mcp.microgifter.com
MICROGIFTER_MCP_ALLOWED_HOSTS=mcp.microgifter.com
MICROGIFTER_MCP_ALLOWED_ORIGINS=
MICROGIFTER_MCP_INTERNAL_TOKEN_SHA256=REPLACE_WITH_64_CHARACTER_SHA256
MICROGIFTER_MCP_INTERNAL_CONNECTION_ID=REPLACE_WITH_CONNECTION_UUID
MICROGIFTER_MCP_INTERNAL_CLIENT_KEY=internal-chatgpt
MICROGIFTER_MCP_INTERNAL_USER_ID=REPLACE_WITH_USER_ID
MICROGIFTER_MCP_BRIDGE_ENABLED=true
MICROGIFTER_MCP_BRIDGE_URL=https://microgifter.com/api/internal/mcp-bridge.php
MICROGIFTER_MCP_BRIDGE_SECRET=REPLACE_WITH_SHARED_BRIDGE_SECRET
MICROGIFTER_MCP_BRIDGE_TIMEOUT_MS=8000
MICROGIFTER_MCP_RATE_LIMIT_REQUESTS=120
MICROGIFTER_MCP_RATE_LIMIT_WINDOW_MS=300000
MICROGIFTER_MCP_SHUTDOWN_GRACE_MS=30000
MICROGIFTER_MCP_LOG_LEVEL=info
MICROGIFTER_MCP_ALLOW_NON_LOOPBACK_BIND=false
