el.querySelector('[data-adopt-round]')?.addEventListener('click',async()=>{const publicName=prompt('Public round name','Microgifter Pre-Seed Round');if(!publicName)return;await post({action:'adopt_round',scenario_id:s.public_id,public_name:publicName,internal_name:`${s.name} Round`});});ui.panel.querySelectorAll('[data-round-form]').forEach((form)=>form.addEventListener('submit',async(event)=>{event.preventDefault();const v=formValues(form);await post({action:'update_round',round_id:form.dataset.roundId,...v,general_solicitation:v.general_solicitation==='1',accredited_investors_required:v.accredited_investors_required==='1'});})); };
  const renderAi = () => { const analyses=state.detail.analyses||[];ui.panel.innerHTML=sectionHead('Step 11','Claude Investment Analyst','Claude receives a saved snapshot and creates draft analysis only. It cannot change official terms, roles, funded amounts, or published content.',canAi?`<button class="mg-btn mg-btn-primary" type="button" data-run-ai>Run Round Readiness Review</button>`:'')+`<div>${analyses.map((a)=>`<article class="mg-analysis-card"><header><div><span class="mg-status-badge is-${esc(a.status)}">${esc(readable(a.status))}</span><h4>${esc(readable(a.analysis_type))}</h4><p>${esc(a.model)} · ${date(a.created_at)}</p></div></header>${a.response_text?`<pre>${esc(a.response_text)}</pre>`:`<p>${esc(a.error_message||'Analysis is being processed.')}</p>`}</article>`).join('')||'<div class="mg-investment-empty"><h2>No AI analyses yet.</h2><p>Complete and save the underlying scenario data first.</p></div>'}</div>`;ui.panel.querySelector('[data-run-ai]')?.addEventListener('click',()=>post({action:'run_ai_analysis',workspace_id:state.detail.workspace.id,scenario_id:activeScenario()?.public_id||null,analysis_type:'round_readiness'})); };
  const renderPanel = () => { ({company:renderCompany,capitalization:renderCapitalization,operating:renderOperating,assumptions:renderAssumptions,scenarios:renderScenarios,use_of_funds:renderBudget,goals:renderGoals,metrics:renderMetrics,documents:renderDocuments,rounds:renderRounds,ai_review:renderAi}[state.step]||renderCompany)(); };
  const render = () => { renderWorkspaceList();if(!state.detail){ui.empty.hidden=false;ui.content.hidden=true;return;}ui.empty.hidden=true;ui.content.hidden=false;ui.title.textContent=state.detail.workspace.name;ui.status.textContent=readable(state.detail.workspace.status);ui.saved.textContent=date(state.detail.workspace.updated_at);renderSteps();renderPanel(); };
  const saveCurrent = async () => {
    if(!state.detail||!canManage)return;
    const form=ui.panel.querySelector('[data-current-form]');
    if(['company','capitalization','operating','assumptions'].includes(state.step)){if(!form)return;await post(workspacePayload(form,state.step));await loadList();return;}
    const s=activeScenario();
    if(state.step==='scenarios'&&form&&s){const values=formValues(form);const assumptions={},stress={};form.querySelectorAll('[data-assumption]').forEach((field)=>assumptions[field.name]=field.value);form.querySelectorAll('[data-stress]').forEach((field)=>stress[field.name]=field.value);await post({action:'save_scenario',scenario_id:s.public_id,...values,assumptions,stress_tests:stress});return;}
    if(state.step==='use_of_funds'&&s){await post({action:'save_budget',scenario_id:s.public_id,items:collectRows('budget')});return;}
    if(state.step==='goals'&&s){await post({action:'save_goals',scenario_id:s.public_id,items:collectRows('goal')});return;}
    if(state.step==='metrics'){await post({action:'save_metrics',workspace_id:state.detail.workspace.id,items:collectRows('metric')});return;}
